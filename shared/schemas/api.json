{
  "$defs": {
    "AnswerSubmission": {
      "additionalProperties": false,
      "description": "The learner's answer to one question: set the field that matches the question kind, or\n`dontKnow` alone to say they do not know yet (scored as a miss, never a guess).",
      "properties": {
        "questionId": {
          "maxLength": 10,
          "minLength": 1,
          "type": "string"
        },
        "choice": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dontKnow": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "questionId"
      ],
      "title": "AnswerSubmission",
      "type": "object"
    },
    "AssessmentProgress": {
      "additionalProperties": false,
      "description": "Where the learner is in the placement assessment.",
      "properties": {
        "answered": {
          "type": "integer"
        },
        "maxQuestions": {
          "type": "integer"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssessmentQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished": {
          "type": "boolean"
        }
      },
      "required": [
        "answered",
        "maxQuestions",
        "question",
        "finished"
      ],
      "title": "AssessmentProgress",
      "type": "object"
    },
    "AssessmentQuestion": {
      "additionalProperties": false,
      "description": "A question as the learner sees it: never includes the answer.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/QuestionKind"
        },
        "prompt": {
          "$ref": "#/$defs/LocalizedText"
        },
        "subskill": {
          "$ref": "#/$defs/LocalizedText"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/LocalizedText"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "prompt",
        "subskill",
        "options"
      ],
      "title": "AssessmentQuestion",
      "type": "object"
    },
    "Badge": {
      "enum": [
        "first_lesson",
        "first_week",
        "first_quiz",
        "streak_7",
        "streak_30"
      ],
      "title": "Badge",
      "type": "string"
    },
    "BillingStatus": {
      "additionalProperties": false,
      "description": "Whether test-mode checkout is set up, and the user's current plan.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "priceCents": {
          "type": "integer"
        }
      },
      "required": [
        "available",
        "tier",
        "priceCents"
      ],
      "title": "BillingStatus",
      "type": "object"
    },
    "Checkin": {
      "additionalProperties": false,
      "description": "A completed check-in and the change it made, at users/{uid}/checkins/{id}.",
      "properties": {
        "id": {
          "type": "string"
        },
        "skillId": {
          "type": "string"
        },
        "weekIndex": {
          "type": "integer"
        },
        "adjustedWeekIndex": {
          "type": "integer"
        },
        "wentWell": {
          "type": "string"
        },
        "hard": {
          "type": "string"
        },
        "feeling": {
          "$ref": "#/$defs/CheckinFeeling"
        },
        "explanation": {
          "type": "string"
        },
        "difficulty": {
          "type": "integer"
        },
        "createdOn": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "id",
        "skillId",
        "weekIndex",
        "adjustedWeekIndex",
        "wentWell",
        "hard",
        "feeling",
        "explanation",
        "difficulty",
        "createdOn"
      ],
      "title": "Checkin",
      "type": "object"
    },
    "CheckinDue": {
      "additionalProperties": false,
      "properties": {
        "skillId": {
          "type": "string"
        },
        "weekIndex": {
          "type": "integer"
        }
      },
      "required": [
        "skillId",
        "weekIndex"
      ],
      "title": "CheckinDue",
      "type": "object"
    },
    "CheckinFeeling": {
      "enum": [
        "too_easy",
        "just_right",
        "too_hard"
      ],
      "title": "CheckinFeeling",
      "type": "string"
    },
    "CheckinRequest": {
      "additionalProperties": false,
      "description": "The weekly check-in; `today` is the learner's own calendar date.",
      "properties": {
        "wentWell": {
          "maxLength": 500,
          "type": "string"
        },
        "hard": {
          "maxLength": 500,
          "type": "string"
        },
        "feeling": {
          "$ref": "#/$defs/CheckinFeeling"
        },
        "today": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "wentWell",
        "hard",
        "feeling",
        "today"
      ],
      "title": "CheckinRequest",
      "type": "object"
    },
    "CheckoutSession": {
      "additionalProperties": false,
      "description": "Where to send the browser for Stripe's hosted test-mode checkout.",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "CheckoutSession",
      "type": "object"
    },
    "CommunityMatch": {
      "additionalProperties": false,
      "description": "A free community or practice format suggested for a skill, with why it fits.",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MatchKind"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "kind",
        "reason"
      ],
      "title": "CommunityMatch",
      "type": "object"
    },
    "CompleteLessonRequest": {
      "additionalProperties": false,
      "description": "Mark a lesson done; `completedOn` is the learner's own calendar date.",
      "properties": {
        "completedOn": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "completedOn"
      ],
      "title": "CompleteLessonRequest",
      "type": "object"
    },
    "ConfirmCheckoutRequest": {
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "maxLength": 255,
          "minLength": 10,
          "pattern": "^cs_test_[A-Za-z0-9_]+$",
          "type": "string"
        }
      },
      "required": [
        "sessionId"
      ],
      "title": "ConfirmCheckoutRequest",
      "type": "object"
    },
    "EnsureProfileRequest": {
      "additionalProperties": false,
      "description": "Sent on sign-in: the learner's own calendar date, so a new demo account's history lines up\nwith their day rather than UTC's.",
      "properties": {
        "today": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EnsureProfileRequest",
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "description": "Liveness payload returned by GET /api/health.",
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "version"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "Language": {
      "enum": [
        "en",
        "ar"
      ],
      "title": "Language",
      "type": "string"
    },
    "LearningStyle": {
      "enum": [
        "reading",
        "video",
        "practice",
        "mixed"
      ],
      "title": "LearningStyle",
      "type": "string"
    },
    "LessonContent": {
      "additionalProperties": false,
      "description": "A lesson's written content plus its tutor conversation, at users/{uid}/lessons/{id}.",
      "properties": {
        "skillId": {
          "type": "string"
        },
        "lessonId": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "exercise": {
          "type": "string"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceLink"
          },
          "type": "array"
        },
        "tutor": {
          "items": {
            "$ref": "#/$defs/TutorMessage"
          },
          "type": "array"
        },
        "generatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en"
        }
      },
      "required": [
        "skillId",
        "lessonId",
        "explanation",
        "exercise",
        "resources",
        "tutor",
        "generatedAt"
      ],
      "title": "LessonContent",
      "type": "object"
    },
    "LessonKind": {
      "enum": [
        "learn",
        "practice",
        "review",
        "project"
      ],
      "title": "LessonKind",
      "type": "string"
    },
    "LessonStatus": {
      "enum": [
        "todo",
        "done"
      ],
      "title": "LessonStatus",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "The same text in English and in Arabic.",
      "properties": {
        "en": {
          "minLength": 1,
          "type": "string"
        },
        "ar": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "en",
        "ar"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "MatchKind": {
      "enum": [
        "community",
        "forum",
        "chat",
        "practice"
      ],
      "title": "MatchKind",
      "type": "string"
    },
    "ModuleQuiz": {
      "additionalProperties": false,
      "description": "A module quiz as the learner sees it: no answers until it is submitted.",
      "properties": {
        "skillId": {
          "type": "string"
        },
        "moduleIndex": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/QuizQuestion"
          },
          "type": "array"
        }
      },
      "required": [
        "skillId",
        "moduleIndex",
        "title",
        "questions"
      ],
      "title": "ModuleQuiz",
      "type": "object"
    },
    "MoveLessonRequest": {
      "additionalProperties": false,
      "description": "Move a lesson to another day, from today to the end of the plan.",
      "properties": {
        "scheduledDate": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "scheduledDate"
      ],
      "title": "MoveLessonRequest",
      "type": "object"
    },
    "OnboardingAnswers": {
      "additionalProperties": false,
      "description": "What the onboarding wizard collects about a new skill.\n\nOnly rules JSON Schema can express live here, so the generated frontend form enforces\nthe same ones. Rules that need the clock live in darb_api.domain.onboarding.",
      "properties": {
        "skill": {
          "maxLength": 80,
          "minLength": 2,
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/SkillReason"
        },
        "level": {
          "$ref": "#/$defs/SelfRatedLevel"
        },
        "hoursPerWeek": {
          "maximum": 40,
          "minimum": 1,
          "type": "integer"
        },
        "preferredDays": {
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "maxItems": 7,
          "minItems": 1,
          "type": "array"
        },
        "learningStyle": {
          "$ref": "#/$defs/LearningStyle"
        },
        "targetDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "skill",
        "reason",
        "level",
        "hoursPerWeek",
        "preferredDays",
        "learningStyle"
      ],
      "title": "OnboardingAnswers",
      "type": "object"
    },
    "PlacementLevel": {
      "enum": [
        "beginner",
        "elementary",
        "intermediate",
        "advanced"
      ],
      "title": "PlacementLevel",
      "type": "string"
    },
    "PlacementResult": {
      "additionalProperties": false,
      "description": "The outcome of the placement assessment, stored on the skill.",
      "properties": {
        "level": {
          "$ref": "#/$defs/PlacementLevel"
        },
        "summary": {
          "$ref": "#/$defs/LocalizedText"
        },
        "subskills": {
          "items": {
            "$ref": "#/$defs/SubskillScore"
          },
          "type": "array"
        },
        "completedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "level",
        "summary",
        "subskills",
        "completedAt"
      ],
      "title": "PlacementResult",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "description": "A skill's study plan: modules, then weeks with dated lessons.",
      "properties": {
        "skillId": {
          "type": "string"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/PlanModule"
          },
          "type": "array"
        },
        "weeks": {
          "items": {
            "$ref": "#/$defs/PlanWeek"
          },
          "type": "array"
        },
        "difficulty": {
          "maximum": 2,
          "minimum": -2,
          "type": "integer"
        },
        "generatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "lastReschedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RescheduleNotice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkedInWeeks": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en"
        }
      },
      "required": [
        "skillId",
        "modules",
        "weeks",
        "difficulty",
        "generatedAt"
      ],
      "title": "Plan",
      "type": "object"
    },
    "PlanLesson": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "minutes": {
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/LessonKind"
        },
        "scheduledDate": {
          "format": "date",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/LessonStatus"
        },
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en"
        }
      },
      "required": [
        "id",
        "title",
        "objective",
        "minutes",
        "kind",
        "scheduledDate",
        "status"
      ],
      "title": "PlanLesson",
      "type": "object"
    },
    "PlanModule": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary"
      ],
      "title": "PlanModule",
      "type": "object"
    },
    "PlanWeek": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer"
        },
        "startDate": {
          "format": "date",
          "type": "string"
        },
        "moduleIndex": {
          "type": "integer"
        },
        "goal": {
          "type": "string"
        },
        "lessons": {
          "items": {
            "$ref": "#/$defs/PlanLesson"
          },
          "type": "array"
        },
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en"
        }
      },
      "required": [
        "index",
        "startDate",
        "moduleIndex",
        "goal",
        "lessons"
      ],
      "title": "PlanWeek",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "description": "Settings the learner chooses. Language also sets the language the AI writes in.",
      "properties": {
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en"
        },
        "checkinReminders": {
          "default": true,
          "type": "boolean"
        },
        "reviewReminders": {
          "default": true,
          "type": "boolean"
        }
      },
      "title": "Preferences",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "description": "The signed-in user's profile, stored at users/{uid}.",
      "properties": {
        "uid": {
          "type": "string"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "default": "free"
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "isDemo",
        "createdAt"
      ],
      "title": "Profile",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": false,
      "description": "Everything the dashboard shows, computed from the learner's own data.",
      "properties": {
        "stats": {
          "$ref": "#/$defs/Stats"
        },
        "badges": {
          "items": {
            "$ref": "#/$defs/Badge"
          },
          "type": "array"
        },
        "quizzes": {
          "items": {
            "$ref": "#/$defs/QuizScorePoint"
          },
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillProgress"
          },
          "type": "array"
        }
      },
      "required": [
        "stats",
        "badges",
        "quizzes",
        "skills"
      ],
      "title": "Progress",
      "type": "object"
    },
    "QuestionKind": {
      "enum": [
        "multiple_choice",
        "short_answer",
        "confidence"
      ],
      "title": "QuestionKind",
      "type": "string"
    },
    "QuestionResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "prompt": {
          "$ref": "#/$defs/LocalizedText"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/LocalizedText"
          },
          "type": "array"
        },
        "chosen": {
          "type": "integer"
        },
        "correctOption": {
          "type": "integer"
        },
        "correct": {
          "type": "boolean"
        },
        "explanation": {
          "$ref": "#/$defs/LocalizedText"
        }
      },
      "required": [
        "id",
        "prompt",
        "options",
        "chosen",
        "correctOption",
        "correct",
        "explanation"
      ],
      "title": "QuestionResult",
      "type": "object"
    },
    "QuizQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "prompt": {
          "$ref": "#/$defs/LocalizedText"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/LocalizedText"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "prompt",
        "options"
      ],
      "title": "QuizQuestion",
      "type": "object"
    },
    "QuizResult": {
      "additionalProperties": false,
      "description": "A graded module quiz, stored at users/{uid}/quizResults/{skillId}__{module}.",
      "properties": {
        "skillId": {
          "type": "string"
        },
        "moduleIndex": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/QuestionResult"
          },
          "type": "array"
        },
        "addedToReview": {
          "type": "integer"
        },
        "completedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "skillId",
        "moduleIndex",
        "title",
        "score",
        "results",
        "addedToReview",
        "completedAt"
      ],
      "title": "QuizResult",
      "type": "object"
    },
    "QuizScorePoint": {
      "additionalProperties": false,
      "properties": {
        "skillId": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "score": {
          "type": "integer"
        },
        "completedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "skillId",
        "skill",
        "title",
        "score",
        "completedAt"
      ],
      "title": "QuizScorePoint",
      "type": "object"
    },
    "QuizSubmission": {
      "additionalProperties": false,
      "description": "One chosen option index per question, in question order.",
      "properties": {
        "answers": {
          "items": {
            "type": "integer"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "answers"
      ],
      "title": "QuizSubmission",
      "type": "object"
    },
    "RegenerateWeekRequest": {
      "additionalProperties": false,
      "description": "Replace a week's unfinished lessons; \"easier\" and \"harder\" shift the plan's difficulty.",
      "properties": {
        "adjust": {
          "$ref": "#/$defs/WeekAdjustment",
          "default": "same"
        }
      },
      "title": "RegenerateWeekRequest",
      "type": "object"
    },
