{
  "$defs": {
    "AnswerSubmission": {
      "additionalProperties": false,
      "description": "The learner's answer to one question; set the field that matches the question kind.",
      "properties": {
        "questionId": {
          "maxLength": 10,
          "minLength": 1,
          "type": "string"
        },
        "choice": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "questionId"
      ],
      "title": "AnswerSubmission",
      "type": "object"
    },
    "AssessmentProgress": {
      "additionalProperties": false,
      "description": "Where the learner is in the placement assessment.",
      "properties": {
        "answered": {
          "type": "integer"
        },
        "maxQuestions": {
          "type": "integer"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssessmentQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished": {
          "type": "boolean"
        }
      },
      "required": [
        "answered",
        "maxQuestions",
        "question",
        "finished"
      ],
      "title": "AssessmentProgress",
      "type": "object"
    },
    "AssessmentQuestion": {
      "additionalProperties": false,
      "description": "A question as the learner sees it: never includes the answer.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/QuestionKind"
        },
        "prompt": {
          "type": "string"
        },
        "subskill": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "prompt",
        "subskill",
        "options"
      ],
      "title": "AssessmentQuestion",
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "description": "Liveness payload returned by GET /api/health.",
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "version"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "LearningStyle": {
      "enum": [
        "reading",
        "video",
        "practice",
        "mixed"
      ],
      "title": "LearningStyle",
      "type": "string"
    },
    "LessonKind": {
      "enum": [
        "learn",
        "practice",
        "review",
        "project"
      ],
      "title": "LessonKind",
      "type": "string"
    },
    "LessonStatus": {
      "enum": [
        "todo",
        "done"
      ],
      "title": "LessonStatus",
      "type": "string"
    },
    "MoveLessonRequest": {
      "additionalProperties": false,
      "description": "Move a lesson to another day, from today to the end of the plan.",
      "properties": {
        "scheduledDate": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "scheduledDate"
      ],
      "title": "MoveLessonRequest",
      "type": "object"
    },
    "OnboardingAnswers": {
      "additionalProperties": false,
      "description": "What the onboarding wizard collects about a new skill.\n\nOnly rules JSON Schema can express live here, so the generated frontend form enforces\nthe same ones. Rules that need the clock live in darb_api.domain.onboarding.",
      "properties": {
        "skill": {
          "maxLength": 80,
          "minLength": 2,
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/SkillReason"
        },
        "level": {
          "$ref": "#/$defs/SelfRatedLevel"
        },
        "hoursPerWeek": {
          "maximum": 40,
          "minimum": 1,
          "type": "integer"
        },
        "preferredDays": {
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "maxItems": 7,
          "minItems": 1,
          "type": "array"
        },
        "learningStyle": {
          "$ref": "#/$defs/LearningStyle"
        },
        "targetDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "skill",
        "reason",
        "level",
        "hoursPerWeek",
        "preferredDays",
        "learningStyle"
      ],
      "title": "OnboardingAnswers",
      "type": "object"
    },
    "PlacementLevel": {
      "enum": [
        "beginner",
        "elementary",
        "intermediate",
        "advanced"
      ],
      "title": "PlacementLevel",
      "type": "string"
    },
    "PlacementResult": {
      "additionalProperties": false,
      "description": "The outcome of the placement assessment, stored on the skill.",
      "properties": {
        "level": {
          "$ref": "#/$defs/PlacementLevel"
        },
        "summary": {
          "type": "string"
        },
        "subskills": {
          "items": {
            "$ref": "#/$defs/SubskillScore"
          },
          "type": "array"
        },
        "completedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "level",
        "summary",
        "subskills",
        "completedAt"
      ],
      "title": "PlacementResult",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "description": "A skill's study plan: modules, then weeks with dated lessons.",
      "properties": {
        "skillId": {
          "type": "string"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/PlanModule"
          },
          "type": "array"
        },
        "weeks": {
          "items": {
            "$ref": "#/$defs/PlanWeek"
          },
          "type": "array"
        },
        "difficulty": {
          "maximum": 2,
          "minimum": -2,
          "type": "integer"
        },
        "generatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "skillId",
        "modules",
        "weeks",
        "difficulty",
        "generatedAt"
      ],
      "title": "Plan",
      "type": "object"
    },
    "PlanLesson": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "minutes": {
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/LessonKind"
        },
        "scheduledDate": {
          "format": "date",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/LessonStatus"
        }
      },
      "required": [
        "id",
        "title",
        "objective",
        "minutes",
        "kind",
        "scheduledDate",
        "status"
      ],
      "title": "PlanLesson",
      "type": "object"
    },
    "PlanModule": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary"
      ],
      "title": "PlanModule",
      "type": "object"
    },
    "PlanWeek": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer"
        },
        "startDate": {
          "format": "date",
          "type": "string"
        },
        "moduleIndex": {
          "type": "integer"
        },
        "goal": {
          "type": "string"
        },
        "lessons": {
          "items": {
            "$ref": "#/$defs/PlanLesson"
          },
          "type": "array"
        }
      },
      "required": [
        "index",
        "startDate",
        "moduleIndex",
        "goal",
        "lessons"
      ],
      "title": "PlanWeek",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "description": "The signed-in user's profile, stored at users/{uid}.",
      "properties": {
        "uid": {
          "type": "string"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "isDemo",
        "createdAt"
      ],
      "title": "Profile",
      "type": "object"
    },
    "QuestionKind": {
      "enum": [
        "multiple_choice",
        "short_answer",
        "confidence"
      ],
      "title": "QuestionKind",
      "type": "string"
    },
    "RegenerateWeekRequest": {
      "additionalProperties": false,
      "description": "Replace a week's unfinished lessons; \"easier\" and \"harder\" shift the plan's difficulty.",
      "properties": {
        "adjust": {
          "$ref": "#/$defs/WeekAdjustment",
          "default": "same"
        }
      },
      "title": "RegenerateWeekRequest",
      "type": "object"
    },
    "SelfRatedLevel": {
      "enum": [
        "none",
        "beginner",
        "elementary",
        "intermediate",
        "advanced"
      ],
      "title": "SelfRatedLevel",
      "type": "string"
    },
    "Skill": {
      "additionalProperties": false,
      "description": "One skill the user is learning, stored at users/{uid}/skills/{id}.",
      "properties": {
        "id": {
          "type": "string"
        },
        "answers": {
          "$ref": "#/$defs/OnboardingAnswers"
        },
        "status": {
          "$ref": "#/$defs/SkillStatus"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlacementResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "answers",
        "status",
        "createdAt"
      ],
      "title": "Skill",
      "type": "object"
    },
    "SkillReason": {
      "enum": [
        "career",
        "hobby",
        "travel",
        "exam",
        "school",
        "personal"
      ],
      "title": "SkillReason",
      "type": "string"
    },
    "SkillStatus": {
      "enum": [
        "onboarded",
        "assessed"
      ],
      "title": "SkillStatus",
      "type": "string"
    },
    "SubskillScore": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "score"
      ],
      "title": "SubskillScore",
      "type": "object"
    },
    "WeekAdjustment": {
      "enum": [
        "same",
        "easier",
        "harder"
      ],
      "title": "WeekAdjustment",
      "type": "string"
    },
    "Weekday": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "title": "Weekday",
      "type": "string"
    }
  },
  "title": "DarbApi",
  "x-request-models": [
    "OnboardingAnswers",
    "AnswerSubmission",
    "RegenerateWeekRequest",
    "MoveLessonRequest"
  ]
}
