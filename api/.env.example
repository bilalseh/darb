# Copy to api/.env for local development. Never commit real values.
ENVIRONMENT=local
APP_VERSION=dev
# `demo-` project IDs work offline with the Firebase emulators.
FIREBASE_PROJECT_ID=demo-darb
LOG_LEVEL=INFO
# Point the API at the local emulators started with `pnpm emulators`.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# AI: "fake" needs no key; "gemini,groq" uses GEMINI_API_KEY and GROQ_API_KEY.
AI_PROVIDERS=fake
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Billing: Stripe TEST MODE keys only (sk_test_...); live keys are refused.
APP_URL=http://localhost:5173
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
